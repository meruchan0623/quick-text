{
  "name": "quicktext",
  "version": "0.3.1",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --check src index.html package.json tsconfig.json vite.config.ts vitest.config.ts eslint.config.js .prettierrc",
    "format:write": "prettier --write src index.html package.json tsconfig.json vite.config.ts vitest.config.ts eslint.config.js .prettierrc",
    "test": "vitest run",
    "check:bundle": "node scripts/check-bundle.mjs",
    "doctor": "npm run typecheck && npm run lint && npm run format && npm run test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.8.4",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "3.9.10",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.1.5",
    "vitest": "^5.0.5"
  }
}
